{
  "name": "errorreporter",
  "version": "1.0.360",
  "description": "Error reporter for client.",
  "keywords": [
    "client",
    "error",
    "reporter"
  ],
  "homepage": "https://torben.website/errorreporter",
  "bugs": {
    "email": "info@torben.website",
    "url": "https://github.com/thaibault/errorreporter/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@torben.website",
    "name": "Torben Sickert",
    "url": "https://torben.website"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/errorreporter"
  },
  "type": "module",
  "files": [
    "index.d.ts",
    "index.js",
    "type.d.ts"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "yarn build:types && yarn build:bundle:compatible",
    "build:bundle": "yarn build:types && yarn build:bundle:compatible",
    "build:bundle:compatible": "yarn build:types && weboptimizer build '{__reference__: [\"target:bundle\", \"target:compatible\"]}'",
    "build:bundle:plain": "weboptimizer build '{__reference__: \"target:bundle\"}'",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build:bundle:compatible",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "weboptimizer test",
    "test:browser": "weboptimizer test:browser",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.5",
    "@babel/plugin-transform-proto-to-assign": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "clientnode": "^4.0.1517",
    "eslint": "^10.10.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^64.4.0",
    "jest": "^30.5.1",
    "jsdoc": "^4.0.5",
    "node-fetch": "^3.3.2",
    "typescript-eslint": "^8.70.0",
    "ua-parser-js": "^2.0.10",
    "web-documentation": "^1.0.57",
    "weboptimizer": "^4.0.84",
    "webpack-dev-server": "^6.0.0"
  },
  "peerDependencies": {
    "ua-parser-js": "*"
  },
  "peerDependenciesMeta": {
    "ua-parser-js": {
      "optional": true
    }
  },
  "resolutions": {
    "colors": "1.4.0",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "tagline": "Error reporter for client.",
    "trackingCode": "UA-40192634-22"
  },
  "webOptimizer": {
    "target:compatible": {
      "exportFormat": {
        "self": "window"
      },
      "libraryName": "errorreporter",
      "module": {
        "preprocessor": {
          "javaScript": {
            "options": {
              "plugins": {
                "__append__": "@babel/plugin-transform-proto-to-assign"
              }
            }
          }
        }
      }
    }
  },
  "packageManager": "yarn@4.18.0"
}
