{
  "name": "errorreporter",
  "version": "1.0.367",
  "description": "Error reporter for client.",
  "keywords": [
    "client",
    "error",
    "reporter"
  ],
  "homepage": "https://tsickert.com/errorreporter",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/errorreporter/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/errorreporter.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./bundle": "./dist/bundle/index.js",
    "./type": "./dist/type.d.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "files": [
    "dist/bundle/index.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/type.d.ts"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "yarn build:types && yarn build:compatible && yarn build:compatible:bundle",
    "build:compatible": "yarn build:types && weboptimizer build '{__reference__: [\"target:compatible\"]}'",
    "build:compatible:bundle": "weboptimizer build '{__reference__: [\"target:compatible\", \"target:bundle\"]}'",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "weboptimizer test",
    "test:browser": "weboptimizer test:browser",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/plugin-transform-proto-to-assign": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "clientnode": "^4.0.1532",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.4.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "node-fetch": "^3.3.2",
    "typescript-eslint": "^8.72.2",
    "ua-parser-js": "^2.0.10",
    "web-documentation": "^1.0.77",
    "weboptimizer": "^4.0.124",
    "webpack-dev-server": "^6.1.0"
  },
  "peerDependencies": {
    "core-js": "*",
    "ua-parser-js": "*"
  },
  "peerDependenciesMeta": {
    "ua-parser-js": {
      "optional": true
    }
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "Error reporter for client."
  },
  "webOptimizer": {
    "target:bundle": {
      "inPlace": {
        "externalLibrary": {
          "dynamic": true,
          "normal": true
        }
      },
      "path": {
        "target": {
          "base": "dist/bundle/"
        }
      }
    },
    "target:compatible": {
      "exportFormat": {
        "self": "window"
      },
      "libraryName": "errorreporter",
      "module": {
        "preprocessor": {
          "javaScript": {
            "options": {
              "plugins": {
                "__append__": "@babel/plugin-transform-proto-to-assign"
              }
            }
          }
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
